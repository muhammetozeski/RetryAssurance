@page "/projects/new"
@inherits ActionPage
@inject PortalApi Api
@inject AccountSession Session
@inject NavigationManager Navigation
<PageTitle>Set up a retry check — Retry Assurance</PageTitle><h1>Set up a retry check</h1><p>Create one job and check whether its retry creates a duplicate.</p><StatusMessage Text="@Message" Error="@Failed" />
@if(!Ready){@if(Busy){<p>Loading settings.</p>}else{<button @onclick="Load">Try again</button>}}
else if(Session.Account is null){<a class="button primary" href="account?next=%2Fprojects%2Fnew">Sign in to continue</a>}
else
{
<section class="panel form-panel"><label>Project name<input @bind="Name" maxlength="100" disabled="@Busy"></label><fieldset><legend>Acceptable final client outcomes</legend><label class="check"><input type="checkbox" @bind="AllowSuccess" disabled="@Busy">Success with a matching job ID</label><label class="check"><input type="checkbox" @bind="AllowIndeterminate" disabled="@Busy">Unresolved timeout</label><label class="check"><input type="checkbox" @bind="AllowFailure" disabled="@Busy">Failure</label><p class="quiet">If you allow a timeout or failure, a one-job result may pass even when the client did not report success.</p></fieldset><details><summary>Test rules and version</summary><p>Your client must use JSON POST jobs and keep the same Idempotency-Key across retries. One client operation may create at most one job. At least two requests are required to test the retry.</p><label>Check name<input @bind="ContractName" maxlength="100" disabled="@Busy"></label><label>Scenario version<select @bind="PackVersion" disabled="@Busy">@foreach(var pack in Packs){<option value="@pack.Version">@pack.Id · @pack.Version — @pack.Title</option>}</select></label><p>The first reply is delayed three seconds; later replies are immediate. Use test data only.</p></details><button class="primary" disabled="@(Busy||Packs.Count==0||string.IsNullOrWhiteSpace(Name)||string.IsNullOrWhiteSpace(ContractName)||!(AllowSuccess||AllowIndeterminate||AllowFailure))" @onclick="Create">Create project</button></section>
}
@code{
string Name="",ContractName="Duplicate prevention",PackVersion="1.0.0";bool AllowSuccess=true,AllowIndeterminate=true,AllowFailure,Ready;List<ScenarioPack> Packs=[];
protected override Task OnInitializedAsync()=>Load();
Task Load()=>Act(async()=>{if(!Session.Loaded)await Session.RefreshAsync();Packs=(await Api.GetAsync<PackList>("packs")).Packs;Ready=true;});
Task Create()=>Act(async()=>{List<string> allowed=[];if(AllowSuccess)allowed.Add("success");if(AllowIndeterminate)allowed.Add("indeterminate");if(AllowFailure)allowed.Add("failure");var result=await Api.PostAsync<CreatedProject>("projects",new{name=Name,packVersion=PackVersion,contract=new{name=ContractName,keyHeader="Idempotency-Key",keyOwner="client",allowedTerminals=allowed}});Navigation.NavigateTo("projects/"+result.ProjectId);});
}
