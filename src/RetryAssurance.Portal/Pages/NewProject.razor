@page "/projects/new"
@inherits ActionPage
@inject PortalApi Api
@inject NavigationManager Navigation
<PageTitle>Declare a behavior contract — Retry Assurance</PageTitle><span class="eyebrow">FIRST JOB · DECLARE BEFORE EXECUTING</span><h1>One logical create operation</h1><p class="lede">This first pack checks a JSON <code>POST jobs</code> operation whose idempotency key is owned by the client. Declare allowed outcomes before running the client.</p><StatusMessage Text="@Message" Error="@Failed" />
<section class="panel form-panel"><label>Project name<input @bind="Name" maxlength="100" disabled="@Busy"></label><label>Behavior contract name<input @bind="ContractName" maxlength="100" disabled="@Busy"></label><div class="fixed-contract"><p><strong>Logical operation count:</strong> one callback invocation</p><p><strong>Key ownership:</strong> client, stable <code>Idempotency-Key</code> across internal retries</p><p><strong>Server effect bound:</strong> at most one durable job</p><p><strong>Exercise requirement:</strong> at least two accepted HTTP attempts; no traffic or unexercised retry behavior is incomplete</p></div><fieldset><legend>Allowed runner terminal observations</legend><label class="check"><input type="checkbox" @bind="AllowSuccess" disabled="@Busy">Success — must reference a resource created in this run</label><label class="check"><input type="checkbox" @bind="AllowIndeterminate" disabled="@Busy">Indeterminate — unresolved client outcome can be valid without pretending eventual success</label><label class="check"><input type="checkbox" @bind="AllowFailure" disabled="@Busy">Failure — the contract permits a reported client failure</label></fieldset><label>Pin the maintained scenario pack<select @bind="PackVersion" disabled="@Busy">@foreach(var pack in Packs){<option value="@pack.Version">@pack.Id · @pack.Version — @pack.Title</option>}</select></label><p class="quiet">The pack creates the first job, commits its evidence and delays its response headers for three seconds. Later requests respond immediately. It uses only synthetic data. New pack versions will require explicit adoption.</p><button class="primary" disabled="@(Busy||Packs.Count==0)" @onclick="Create">Create account-owned project and immutable revision 1</button><p><a href="/account">Create or recover an account first</a> if you are not signed in.</p></section>
@code{
string Name="",ContractName="",PackVersion="1.0.0";bool AllowSuccess=true,AllowIndeterminate=true,AllowFailure;List<ScenarioPack> Packs=[];
protected override Task OnInitializedAsync()=>Act(async()=>{Packs=(await Api.GetAsync<PackList>("packs")).Packs;});
Task Create()=>Act(async()=>{List<string> allowed=[];if(AllowSuccess)allowed.Add("success");if(AllowIndeterminate)allowed.Add("indeterminate");if(AllowFailure)allowed.Add("failure");var result=await Api.PostAsync<CreatedProject>("projects",new{name=Name,packVersion=PackVersion,contract=new{name=ContractName,keyHeader="Idempotency-Key",keyOwner="client",allowedTerminals=allowed}});Navigation.NavigateTo("/projects/"+result.ProjectId);});
}
