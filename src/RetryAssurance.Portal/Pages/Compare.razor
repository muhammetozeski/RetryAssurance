@page "/compare/{CurrentId}/{BaselineId}"
@inherits ActionPage
@inject PortalApi Api
<PageTitle>Compare actual executions — Retry Assurance</PageTitle><span class="eyebrow">TWO SEPARATE EXECUTIONS · RETAINED EVIDENCE</span><h1>What changed?</h1><StatusMessage Text="@Message" Error="@Failed" />
@if(Comparison is {} data){<div class="notice @(data.Comparable?"":"error")"><strong>@(data.Comparable?"Compatible scenario and contract pins":"Different experimental pins")</strong><p>@data.Reason</p></div><div class="comparison-grid">@foreach(var item in new[]{data.Baseline,data.Current}){<section class="comparison-column"><span class="eyebrow">@(ReferenceEquals(item,data.Baseline)?"BASELINE":"CURRENT")</span><span class="verdict @(item.Run.Result?.Verdict??"open")">@(item.Run.Result?.Verdict??item.Run.State)</span><h2>@item.Run.Client</h2><p>Package @item.Run.PackageVersion</p><p class="mono">@item.Run.CommitId</p><dl class="identity"><dt>Durable resources</dt><dd class="comparison-value">@item.Resources.Count</dd><dt>Accepted HTTP attempts</dt><dd>@item.Requests.Count</dd><dt>Distinct key digests</dt><dd>@item.Requests.Select(request=>request.KeyHash).Distinct().Count()</dd><dt>Runner-reported terminal</dt><dd>@(item.Run.Result?.RunnerReported.Terminal??"Not finalized")</dd><dt>Contract / pack</dt><dd>@item.Run.ContractRevision / @item.Run.PackVersion</dd></dl><a class="button" href="@("/runs/"+item.Run.Id)">Read full journal</a>@if(item.Run.Result?.Issues is {} issues&&issues.Count>0){<ul>@foreach(var issue in issues){<li>@issue</li>}</ul>}</section>}</div><p class="quiet">Both effect sets stay isolated. The service does not rewrite a baseline or infer which source change caused a difference. Client and build labels remain runner declarations.</p><a href="@("/projects/"+data.Current.Run.ProjectId)">Return to the shared project workflow →</a>}
@code{
[Parameter]public string CurrentId{get;set;}="";[Parameter]public string BaselineId{get;set;}="";ExecutionComparison? Comparison;
protected override async Task OnParametersSetAsync(){var current=CurrentId;var baseline=BaselineId;Comparison=null;Message="";try{var result=await Api.GetAsync<ExecutionComparison>("runs/"+current+"/compare/"+baseline);if(!Disposed&&CurrentId==current&&BaselineId==baseline)Comparison=result;}catch(Exception error){if(!Disposed&&CurrentId==current&&BaselineId==baseline)ShowFailure(error);}}
}
