@page "/compare/{CurrentId}/{BaselineId}"
@inherits ActionPage
@inject PortalApi Api
<PageTitle>Compare runs — Retry Assurance</PageTitle><h1>Compare runs</h1><StatusMessage Text="@Message" Error="@Failed" />
@if(Comparison is {} data){<div class="notice @(data.Comparable?"":"error")"><strong>@(data.Comparable?"Same check and scenario":"Different check or scenario")</strong>@if(!data.Comparable){<p>These results are not a like-for-like comparison.</p>}</div><div class="comparison-grid">@foreach(var item in new[]{data.Baseline,data.Current}){<section class="comparison-column"><h2>@(ReferenceEquals(item,data.Baseline)?"Baseline":"Selected run")</h2><span class="verdict @(item.Run.Result?.Verdict??"open")">@(item.Run.Result?.Verdict??item.Run.State)</span><p>@item.Run.Client</p><p>Package @item.Run.PackageVersion · build <code>@item.Run.CommitId</code></p><dl class="identity"><dt>Test jobs created</dt><dd class="comparison-value">@item.Resources.Count</dd><dt>Requests recorded</dt><dd>@item.Requests.Count</dd><dt>Keys used</dt><dd>@item.Requests.Select(request=>request.KeyHash).Distinct().Count()</dd><dt>Client outcome</dt><dd>@(item.Run.Result is {} result?ClientOutcome(result.RunnerReported.Terminal):"Not finished")</dd><dt>Check / scenario</dt><dd>@item.Run.ContractRevision / @item.Run.PackVersion</dd></dl><a class="button" href="@("runs/"+item.Run.Id)">Open result</a>@if(item.Run.Result?.Issues is {} issues&&issues.Count>0){<ul>@foreach(var issue in issues){<li>@issue</li>}</ul>}</section>}</div><details><summary>About this comparison</summary><p>Client and build labels are supplied by the runner. A result difference alone does not establish which code change caused it.</p></details><a href="@("projects/"+data.Current.Run.ProjectId)">Back to project</a>}
else{<p>@(Reading?"Loading comparison.":"Comparison unavailable. Check the run IDs and project access.")</p>}
@code{
[Parameter]public string CurrentId{get;set;}="";[Parameter]public string BaselineId{get;set;}="";ExecutionComparison? Comparison;bool Reading=true;
protected override async Task OnParametersSetAsync(){var current=CurrentId;var baseline=BaselineId;Comparison=null;Message="";Reading=true;try{var result=await Api.GetAsync<ExecutionComparison>("runs/"+current+"/compare/"+baseline);if(!Disposed&&CurrentId==current&&BaselineId==baseline)Comparison=result;}catch(Exception error){if(!Disposed&&CurrentId==current&&BaselineId==baseline)ShowFailure(error);}finally{if(!Disposed&&CurrentId==current&&BaselineId==baseline)Reading=false;}}
}
