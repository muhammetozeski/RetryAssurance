@page "/projects/{Id}"
@inherits ActionPage
@inject PortalApi Api
@inject NavigationManager Navigation
<PageTitle>Project workflow — Retry Assurance</PageTitle><StatusMessage Text="@Message" Error="@Failed" />
@if(Detail is null){<h1>Read the project</h1><p>The service must authorize this session before project evidence is shown.</p><a href="/account">Create or recover the actual account</a>}
else
{
<div class="title-row"><div><span class="eyebrow">@Detail.Project.Role · ACTUAL PROJECT</span><h1>@Detail.Project.Name</h1></div><button disabled="@Busy" @onclick="Refresh">Refresh server state</button></div><p class="mono quiet">@Detail.Project.Id</p>
<div class="workflow"><a href="#contract"><b>1</b>Declare and pin</a><a href="#capabilities"><b>2</b>Authorize your runner</a><a href="#executions"><b>3</b>Execute and compare</a></div>
<section id="contract" class="panel"><div class="title-row"><h2>1. Immutable behavior contract</h2><span class="tag">CURRENT REVISION @Detail.Project.ContractRevision</span></div>@if(CurrentContract is {} contract){<p><strong>@contract.Document.Name</strong></p><dl class="facts"><div><dt>Operation</dt><dd>One logical create</dd></div><div><dt>Key owner</dt><dd>@contract.Document.KeyOwner</dd></div><div><dt>Allowed terminal observations</dt><dd>@string.Join(", ",contract.Document.AllowedTerminals)</dd></div><div><dt>Pack pin</dt><dd>ra-core @contract.PackVersion</dd></div></dl><details><summary>Content identities and contract history</summary><p>Contract hash <code class="digest">@contract.DocumentHash</code></p><p>Pack hash <code class="digest">@contract.PackHash</code></p><ul>@foreach(var item in Detail.Contracts){<li>Revision @item.Revision · pack @item.PackVersion · @item.Document.Name · @Time(item.CreatedAt)</li>}</ul></details>}
@if(IsOwner){<details><summary>Publish an explicitly adopted behavior revision</summary><p>Editing starts from revision @DraftRevision. Submitting creates a new immutable revision. Existing runs keep their original contract.</p>@if(DraftRevision!=Detail.Project.ContractRevision){<p class="notice error">Server revision is @Detail.Project.ContractRevision; this draft still starts at @DraftRevision. Compare before updating.</p>}<label>Project name<input @bind="NameDraft" maxlength="100" disabled="@Busy"></label><label>Contract name<input @bind="ContractDraft" maxlength="100" disabled="@Busy"></label><label class="check"><input type="checkbox" @bind="SuccessDraft" disabled="@Busy">Allow successful client observation with a matching server resource</label><label class="check"><input type="checkbox" @bind="IndeterminateDraft" disabled="@Busy">Allow indeterminate client observation</label><label class="check"><input type="checkbox" @bind="FailureDraft" disabled="@Busy">Allow client failure observation</label><label>Explicit pack version<select @bind="PackDraft" disabled="@Busy">@foreach(var pack in AvailablePacks){<option value="@pack.Version">@pack.Id @pack.Version</option>}</select></label><div class="actions"><button disabled="@Busy" @onclick="PublishContract">Publish next revision with expected-revision check</button><button disabled="@Busy" @onclick="ResetDraft">Replace editor with current server contract</button></div></details>}
</section>
<section id="capabilities" class="panel"><h2>2. Scoped runner authorization</h2><p>Runner capabilities can create executions only in this project while their creator remains owner/editor. They cannot open an account. Revocation also blocks issued child-run capabilities.</p>
@if(CanOperate){<div class="inline-fields"><label>Capability label<input @bind="CapabilityLabel" maxlength="80" placeholder="For example: release CI" disabled="@Busy"></label><button disabled="@Busy" @onclick="CreateCapability">Create actual runner capability</button></div>}
@if(NewCapability is not null){<div class="secret-panel"><h3>Copy this capability privately once</h3><p>@NewCapability.Scope</p><label>Project capability — use as RA_PROJECT_TOKEN<input type="@(RevealCapability?"text":"password")" value="@NewCapability.Token" readonly autocomplete="off"></label><div class="actions"><button disabled="@Busy" @onclick="()=>RevealCapability=!RevealCapability">@(RevealCapability?"Hide":"Reveal")</button><button disabled="@Busy" @onclick="()=>Act(()=>Copy(NewCapability.Token))">Copy for private CI secret</button><button disabled="@Busy" @onclick="ClearCapability">I saved it; clear this view</button></div><p class="quiet">It is not stored in browser local storage. Leaving this page discards this visible copy. The metadata below lets you revoke a lost or unused token.</p></div>}
<ul class="record-list">@foreach(var capability in Detail.Capabilities){<li><div><strong>@capability.Label</strong><p class="mono quiet">@capability.Id</p><p>@(capability.RevokedAt is not null?"Revoked "+Time(capability.RevokedAt.Value):"Expires "+Time(capability.ExpiresAt))</p></div>@if(CanOperate&&capability.RevokedAt is null){<button disabled="@Busy" @onclick="()=>Revoke(capability.Id)">Revoke this capability</button>}</li>}</ul>
@if(Detail.Capabilities.Count==0){<p class="empty-note">No runner capability has been created for this actual project.</p>}
</section>
<section class="panel"><h2>Run the real client in your environment</h2><p>Use the public source or the portable runner distribution. Supply the project capability privately as <code>RA_PROJECT_TOKEN</code>; it is deliberately absent from the command.</p><pre>@CorrectCommand</pre><div class="actions"><button disabled="@Busy" @onclick="()=>Act(()=>Copy(CorrectCommand))">Copy command without a secret</button><a class="button" href="/runner">Working C# adapter and setup</a></div><p class="quiet">These first-party examples use dummy credentials and synthetic input. Adapting your SDK requires injection of the supplied HttpClient. Package and build labels are declared by the runner, not remote code attestation.</p></section>
<section id="executions" class="panel"><div class="title-row"><h2>3. Actual executions</h2><button disabled="@Busy" @onclick="Refresh">Read current evidence list</button></div><p>A replay is a new run. Select a previous record as a baseline and retain the same pinned contract/pack for a controlled comparison.</p>
@if(Runs.Count==0){<div class="empty-state"><h3>No execution has reached this project.</h3><p>No demonstration run is inserted here. Execute a real client with the scoped capability, then refresh this list.</p></div>}
@foreach(var run in Runs){<article class="run-list-item"><div><span class="verdict @(run.Verdict??"open")">@(run.Verdict??run.State)</span><h3><a href="@("/runs/"+run.Id)">@run.Client</a></h3><p>Package @run.PackageVersion · build <code>@run.CommitId</code></p><p class="quiet">Contract @run.ContractRevision · pack @run.PackVersion · @Time(run.CreatedAt)</p></div><div class="actions"><a class="button" href="@("/runs/"+run.Id)">Inspect actual evidence</a><button disabled="@Busy" @onclick="()=>SelectBaseline(run)">Use as replay baseline</button></div></article>}
@if(Baseline is not null){<div class="scope-callout"><h3>New execution from a pinned baseline</h3><p>Baseline <code>@Baseline.Id</code>. The command explicitly selects its contract revision; it does not reopen or rewrite the baseline.</p><pre>@ReplayCommand</pre><button disabled="@Busy" @onclick="()=>Act(()=>Copy(ReplayCommand))">Copy replay command without a secret</button></div>}
</section>
@if(IsOwner){<section class="panel"><h2>Project members</h2><p>Viewers read evidence. Editors can operate scoped runners. Only the owner can change contracts and manage members. Removing/downgrading an editor also revokes their issued project capabilities.</p><div class="inline-fields"><label>Invitation role<select @bind="InvitationRole" disabled="@Busy"><option value="viewer">Viewer</option><option value="editor">Editor</option></select></label><button disabled="@Busy" @onclick="CreateInvite">Create one-use invitation</button></div>@if(InvitationUrl.Length>0){<label>Private invitation link — expires in one day<input type="password" readonly value="@InvitationUrl" autocomplete="off"></label><button disabled="@Busy" @onclick="()=>Act(()=>Copy(InvitationUrl))">Copy invitation for your intended colleague</button><p class="quiet">The token is in a fragment, not a server query. The recipient must use an actual account to accept it.</p>}<ul class="record-list">@foreach(var member in Members){<li><div><strong>@member.Alias</strong><p>@member.Role · <span class="mono">@member.Id</span></p></div>@if(member.Role!="owner"){<div class="actions"><button disabled="@Busy" @onclick='()=>ChangeMember(member.Id,member.Role=="editor"?"viewer":"editor")'>Make @(member.Role=="editor"?"viewer":"editor")</button><button disabled="@Busy" @onclick='()=>ChangeMember(member.Id,"remove")'>Remove access</button></div>}</li>}</ul></section>}
}
@code{
[Parameter]public string Id{get;set;}="";
ProjectDetail? Detail;List<RunSummary> Runs=[];List<ScenarioPack> AvailablePacks=[];List<ProjectMember> Members=[];CreatedCapability? NewCapability;RunSummary? Baseline;
string LoadedId="",NameDraft="",ContractDraft="",PackDraft="1.0.0",CapabilityLabel="",InvitationRole="viewer",InvitationUrl="";int DraftRevision;bool SuccessDraft,IndeterminateDraft,FailureDraft,RevealCapability;
bool IsOwner=>Detail?.Project.Role=="owner";bool CanOperate=>Detail?.Project.Role is "owner" or "editor";
ContractRevision? CurrentContract=>Detail?.Contracts.FirstOrDefault(item=>item.Revision==Detail.Project.ContractRevision);
string Origin=>new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
string CorrectCommand=>$"dotnet examples/CorrectClient/bin/Release/net10.0/CorrectClient.dll --server {Origin} --commit YOUR_ACTUAL_COMMIT --revision {Detail?.Project.ContractRevision}";
string ReplayCommand=>$"dotnet examples/CorrectClient/bin/Release/net10.0/CorrectClient.dll --server {Origin} --commit YOUR_NEW_ACTUAL_COMMIT --baseline {Baseline?.Id} --revision {Baseline?.ContractRevision}";
protected override async Task OnParametersSetAsync(){var target=Id;if(LoadedId!=target){Detail=null;NewCapability=null;InvitationUrl="";Baseline=null;Message="";}try{await ReadProject();}catch(Exception error){if(!Disposed&&Id==target)ShowFailure(error);}}
async Task ReadProject(bool reset=false){var target=Id;var detailTask=Api.GetAsync<ProjectDetail>("projects/"+target);var runsTask=Api.GetAsync<RunList>("projects/"+target+"/runs");var packsTask=Api.GetAsync<PackList>("packs");await Task.WhenAll(detailTask,runsTask,packsTask);if(Disposed||Id!=target)return;var fresh=await detailTask;var changed=LoadedId!=target;if(changed){NewCapability=null;InvitationUrl="";Baseline=null;Members=[];}Detail=fresh;Runs=(await runsTask).Runs;AvailablePacks=(await packsTask).Packs;LoadedId=target;if(changed||reset||DraftRevision==0)LoadDraft();if(fresh.Project.Role=="owner"){var members=await Api.GetAsync<MemberList>("projects/"+target+"/members");if(Id==target&&!Disposed)Members=members.Members;}else Members=[];}
void LoadDraft(){if(CurrentContract is not {} current)return;NameDraft=Detail!.Project.Name;ContractDraft=current.Document.Name;PackDraft=current.PackVersion;DraftRevision=current.Revision;SuccessDraft=current.Document.AllowedTerminals.Contains("success");IndeterminateDraft=current.Document.AllowedTerminals.Contains("indeterminate");FailureDraft=current.Document.AllowedTerminals.Contains("failure");}
Task Refresh()=>Act(async()=>{await ReadProject();Done("Actual project state and execution list refreshed. Unsaved contract edits were preserved.");});
Task ResetDraft()=>Act(async()=>{if(!await Browser.InvokeAsync<bool>("confirm","Replace the contract editor with the current server revision? Unsaved editor text will be replaced."))return;LoadDraft();Done("Editor now starts from the current server revision.");});
Task PublishContract()=>Act(async()=>{var target=Id;List<string> allowed=[];if(SuccessDraft)allowed.Add("success");if(IndeterminateDraft)allowed.Add("indeterminate");if(FailureDraft)allowed.Add("failure");var result=await Api.PostAsync<UpdatedRevision>("projects/"+target+"/contracts",new{revision=DraftRevision,name=NameDraft,packVersion=PackDraft,contract=new{name=ContractDraft,keyHeader="Idempotency-Key",keyOwner="client",allowedTerminals=allowed}});if(Id!=target||Disposed)return;await ReadProject(true);if(Id==target)Done($"Immutable behavior revision {result.Revision} published. Existing runs retain their original pins.");});
Task CreateCapability()=>Act(async()=>{var target=Id;var result=await Api.PostAsync<CreatedCapability>("projects/"+target+"/capabilities",new{label=CapabilityLabel});if(Id!=target||Disposed)return;NewCapability=result;RevealCapability=false;await ReadProject();Done("Actual scoped capability created. Copy it privately before leaving this view.");});
void ClearCapability(){NewCapability=null;RevealCapability=false;}
Task Revoke(string capabilityId)=>Act(async()=>{var target=Id;if(!await Browser.InvokeAsync<bool>("confirm","Revoke this runner capability and its issued child-run access? Account-authorized historical evidence remains."))return;if(Id!=target||Disposed)return;await Api.PostAsync<Acknowledgement>("projects/"+target+"/capabilities/"+capabilityId,new{});if(Id!=target||Disposed)return;if(NewCapability?.Id==capabilityId)ClearCapability();await ReadProject();Done("The service revoked the capability. New mint and child-run requests are rejected.");});
void SelectBaseline(RunSummary run){Baseline=run;Done("Baseline selected. Use the replay command to create a separate actual execution.");}
Task CreateInvite()=>Act(async()=>{var target=Id;var result=await Api.PostAsync<CreatedInvitation>("projects/"+target+"/invites",new{role=InvitationRole});if(Id!=target||Disposed)return;InvitationUrl=Origin+"/account#invite="+Uri.EscapeDataString(result.Token);Done("Actual one-use invitation created. Share it only with the intended colleague.");});
Task ChangeMember(string memberId,string role)=>Act(async()=>{var target=Id;if(!await Browser.InvokeAsync<bool>("confirm",$"Change this member's access to '{role}'? Downgrading or removing an editor revokes their issued runner capabilities."))return;if(Id!=target||Disposed)return;await Api.PostAsync<Acknowledgement>("projects/"+target+"/members/"+memberId,new{role});if(Id!=target||Disposed)return;await ReadProject();Done("The actual member access was changed.");});
}

