@page "/projects/{Id}"
@inherits ActionPage
@inject PortalApi Api
@inject NavigationManager Navigation
<PageTitle>Project — Retry Assurance</PageTitle><StatusMessage Text="@Message" Error="@Failed" />
@if(Detail is null){<h1>@(Reading?"Loading project":"Project unavailable")</h1>@if(!Reading){<a href="@("account?next="+Uri.EscapeDataString("/projects/"+Id))">Sign in with project access</a>}}
else
{
<div class="title-row"><div><h1>@Detail.Project.Name</h1><p class="quiet">@Detail.Project.Role · check version @Detail.Project.ContractRevision</p></div><button disabled="@Busy" @onclick="Refresh">Refresh</button></div>
@if(CanOperate){<div class="workflow"><a href="@("projects/"+Id+"#capabilities")"><b>1</b>Get a runner key</a><a href="@("projects/"+Id+"#runner")"><b>2</b>Run your client</a><a href="@("projects/"+Id+"#executions")"><b>3</b>Read the result</a></div>}else{<p>You can read results. An owner can give you editor access to run checks.</p>}
<details id="contract" class="panel"><summary>Check settings and versions</summary>@if(CurrentContract is {} contract){<p><strong>@contract.Document.Name</strong></p><dl class="facts"><div><dt>Operation</dt><dd>One job creation</dd></div><div><dt>Retry key</dt><dd>Created by the client</dd></div><div><dt>Allowed client outcomes</dt><dd>@string.Join(", ",contract.Document.AllowedTerminals.Select(ClientOutcome))</dd></div><div><dt>Scenario</dt><dd>ra-core @contract.PackVersion</dd></div></dl><details><summary>Version details</summary><p>Check fingerprint <code class="digest">@contract.DocumentHash</code></p><p>Scenario fingerprint <code class="digest">@contract.PackHash</code></p><ul>@foreach(var item in Detail.Contracts){<li>Version @item.Revision · scenario @item.PackVersion · @item.Document.Name · @Time(item.CreatedAt)</li>}</ul><p class="mono">Project ID: @Detail.Project.Id</p></details>}
@if(IsOwner){<details><summary>Change settings</summary><p>Starts from version @DraftRevision. Earlier runs keep their own settings.</p>@if(DraftRevision!=Detail.Project.ContractRevision){<p class="notice error">A newer version exists. Compare it before saving your changes.</p>}<label>Project name<input @bind="NameDraft" maxlength="100" disabled="@Busy"></label><label>Check name<input @bind="ContractDraft" maxlength="100" disabled="@Busy"></label><label class="check"><input type="checkbox" @bind="SuccessDraft" disabled="@Busy">Allow success with a matching job ID</label><label class="check"><input type="checkbox" @bind="IndeterminateDraft" disabled="@Busy">Allow an unresolved timeout</label><label class="check"><input type="checkbox" @bind="FailureDraft" disabled="@Busy">Allow a final failure</label><label>Scenario version<select @bind="PackDraft" disabled="@Busy">@foreach(var pack in AvailablePacks){<option value="@pack.Version">@pack.Id @pack.Version</option>}</select></label><div class="actions"><button disabled="@Busy" @onclick="PublishContract">Save new version</button><button disabled="@Busy" @onclick="ResetDraft">Load saved settings</button></div></details>}
</details>
<section id="capabilities" class="panel"><h2>Runner keys</h2>
@if(CanOperate){<div class="inline-fields"><label>Key name<input @bind="CapabilityLabel" maxlength="80" placeholder="For example: release build" disabled="@Busy"></label><button class="primary" disabled="@(Busy||string.IsNullOrWhiteSpace(CapabilityLabel))" @onclick="CreateCapability">Create key</button></div>}
@if(NewCapability is not null){<div class="secret-panel"><h3>Save this key</h3><p>Shown once. Use it as RA_PROJECT_TOKEN in your build's secret store.</p><label>Runner key<input type="@(RevealCapability?"text":"password")" value="@NewCapability.Token" readonly autocomplete="off"></label><div class="actions"><button disabled="@Busy" @onclick="()=>RevealCapability=!RevealCapability">@(RevealCapability?"Hide":"Reveal")</button><button disabled="@Busy" @onclick="()=>Act(()=>Copy(NewCapability.Token))">Copy key</button><button disabled="@Busy" @onclick="ClearCapability">I saved it</button></div><p class="quiet">Expires @Time(NewCapability.ExpiresAt). If lost, revoke it and create another.</p></div>}
<details><summary>Existing keys (@Detail.Capabilities.Count)</summary><p>Up to ten active keys per project. A key only runs checks here. Revoking it stops further requests; saved results remain.</p><ul class="record-list">@foreach(var capability in Detail.Capabilities){<li><div><strong>@capability.Label</strong><p>@(capability.RevokedAt is not null?"Revoked "+Time(capability.RevokedAt.Value):"Expires "+Time(capability.ExpiresAt))</p></div>@if(CanOperate&&capability.CanRevoke&&capability.RevokedAt is null){<button disabled="@Busy" @onclick="()=>Revoke(capability.Id)">Revoke</button>}</li>}</ul>@if(Detail.Capabilities.Count==0){<p>No keys yet.</p>}</details>
</section>
@if(CanOperate){<section id="runner" class="panel"><h2>Run your client</h2><p>Set RA_PROJECT_TOKEN privately, then run your client on your computer or in your build.</p><a class="button" href="runner#own-client">Connect your client</a><details open="@(Runs.Count==0)"><summary>Try the stable-key example</summary><p>From the extracted example folder:</p><pre>@CorrectCommand</pre><div class="actions"><button disabled="@Busy" @onclick="()=>Act(()=>Copy(CorrectCommand))">Copy example command</button><a href="runner">Download and setup</a></div><p>This runs the supplied example, not your own client.</p></details></section>}
<section id="executions" class="panel"><div class="title-row"><h2>Recent runs</h2><button disabled="@Busy" @onclick="Refresh">Refresh results</button></div>
@if(Runs.Count==0){<p>No runs yet. Run a client with this project's key, then refresh.</p>}
@foreach(var run in Runs){<article class="run-list-item"><div><span class="verdict @(run.Verdict??"open")">@(run.Verdict??run.State)</span><h3><a href="@("runs/"+run.Id)">@run.Client</a></h3><p>Package @run.PackageVersion · build <code>@run.CommitId</code></p><p class="quiet">Check @run.ContractRevision · scenario @run.PackVersion · @Time(run.CreatedAt)</p></div><div class="actions"><a class="button" href="@("runs/"+run.Id)">Open result</a>@if(CanOperate){<button disabled="@Busy" @onclick="()=>SelectBaseline(run)">Use as baseline</button>}</div></article>}
@if(Runs.Count==100){<p class="quiet">Showing the latest 100 runs. Older result links still work.</p>}
@if(Baseline is not null){<div class="scope-callout"><h3>Compare the next run</h3><p>Add these options to your own runner command. They create a new run using the baseline's settings.</p><pre>@ReplayCommand</pre><button disabled="@Busy" @onclick="()=>Act(()=>Copy(ReplayCommand))">Copy comparison options</button></div>}
</section>
@if(IsOwner){<details class="panel"><summary>Team access</summary><p>Viewers read results. Editors run checks. Change existing members below; invitations do not replace their current access.</p><div class="inline-fields"><label>Invite as<select @bind="InvitationRole" disabled="@Busy"><option value="viewer">Viewer</option><option value="editor">Editor</option></select></label><button disabled="@Busy" @onclick="CreateInvite">Create invitation</button></div>@if(InvitationUrl.Length>0){<label>Invitation link — expires in one day<input type="password" readonly value="@InvitationUrl" autocomplete="off"></label><button disabled="@Busy" @onclick="()=>Act(()=>Copy(InvitationUrl))">Copy invitation</button><p>The recipient needs an account.</p>}<ul class="record-list">@foreach(var member in Members){<li><div><strong>@member.Alias</strong><p>@member.Role</p></div>@if(member.Role!="owner"){<div class="actions"><button disabled="@Busy" @onclick='()=>ChangeMember(member.Id,member.Role=="editor"?"viewer":"editor")'>Make @(member.Role=="editor"?"viewer":"editor")</button><button disabled="@Busy" @onclick='()=>ChangeMember(member.Id,"remove")'>Remove access</button></div>}</li>}</ul></details>}
}
@code{
[Parameter]public string Id{get;set;}="";
ProjectDetail? Detail;List<RunSummary> Runs=[];List<ScenarioPack> AvailablePacks=[];List<ProjectMember> Members=[];CreatedCapability? NewCapability;RunSummary? Baseline;
string LoadedId="",NameDraft="",ContractDraft="",PackDraft="1.0.0",CapabilityLabel="",InvitationRole="viewer",InvitationUrl="";int DraftRevision;bool SuccessDraft,IndeterminateDraft,FailureDraft,RevealCapability,Reading=true;
bool IsOwner=>Detail?.Project.Role=="owner";bool CanOperate=>Detail?.Project.Role is "owner" or "editor";
ContractRevision? CurrentContract=>Detail?.Contracts.FirstOrDefault(item=>item.Revision==Detail.Project.ContractRevision);
string Origin=>new Uri(Navigation.BaseUri).AbsoluteUri;
string CorrectCommand=>$"dotnet CorrectClient/CorrectClient.dll --server {Origin} --commit YOUR_COMMIT --revision {Detail?.Project.ContractRevision}";
string ReplayCommand=>$"--server {Origin} --commit YOUR_NEW_COMMIT --baseline {Baseline?.Id} --revision {Baseline?.ContractRevision}";
protected override async Task OnParametersSetAsync(){var target=Id;Reading=true;if(LoadedId!=target){Detail=null;NewCapability=null;InvitationUrl="";Baseline=null;Message="";}try{await ReadProject();}catch(Exception error){if(!Disposed&&Id==target)ShowFailure(error);}finally{if(!Disposed&&Id==target)Reading=false;}}
async Task ReadProject(bool reset=false){var target=Id;var detailTask=Api.GetAsync<ProjectDetail>("projects/"+target);var runsTask=Api.GetAsync<RunList>("projects/"+target+"/runs");var packsTask=Api.GetAsync<PackList>("packs");await Task.WhenAll(detailTask,runsTask,packsTask);if(Disposed||Id!=target)return;var fresh=await detailTask;var changed=LoadedId!=target;if(changed){NewCapability=null;InvitationUrl="";Baseline=null;Members=[];}Detail=fresh;Runs=(await runsTask).Runs;AvailablePacks=(await packsTask).Packs;LoadedId=target;if(changed||reset||DraftRevision==0)LoadDraft();if(fresh.Project.Role=="owner"){var members=await Api.GetAsync<MemberList>("projects/"+target+"/members");if(Id==target&&!Disposed)Members=members.Members;}else Members=[];}
void LoadDraft(){if(CurrentContract is not {} current)return;NameDraft=Detail!.Project.Name;ContractDraft=current.Document.Name;PackDraft=current.PackVersion;DraftRevision=current.Revision;SuccessDraft=current.Document.AllowedTerminals.Contains("success");IndeterminateDraft=current.Document.AllowedTerminals.Contains("indeterminate");FailureDraft=current.Document.AllowedTerminals.Contains("failure");}
Task Refresh()=>Act(async()=>{await ReadProject();Done("Project refreshed. Your unsaved settings were kept.");});
Task ResetDraft()=>Act(async()=>{if(!await Browser.InvokeAsync<bool>("confirm","Replace your edited settings with the saved version?"))return;LoadDraft();Done("Saved settings loaded.");});
Task PublishContract()=>Act(async()=>{var target=Id;List<string> allowed=[];if(SuccessDraft)allowed.Add("success");if(IndeterminateDraft)allowed.Add("indeterminate");if(FailureDraft)allowed.Add("failure");var result=await Api.PostAsync<UpdatedRevision>("projects/"+target+"/contracts",new{revision=DraftRevision,name=NameDraft,packVersion=PackDraft,contract=new{name=ContractDraft,keyHeader="Idempotency-Key",keyOwner="client",allowedTerminals=allowed}});if(Id!=target||Disposed)return;await ReadProject(true);if(Id==target)Done($"Check version {result.Revision} saved.");});
Task CreateCapability()=>Act(async()=>{var target=Id;var result=await Api.PostAsync<CreatedCapability>("projects/"+target+"/capabilities",new{label=CapabilityLabel});if(Id!=target||Disposed)return;NewCapability=result;RevealCapability=false;await ReadProject();Done("");});
void ClearCapability(){NewCapability=null;RevealCapability=false;}
Task Revoke(string capabilityId)=>Act(async()=>{var target=Id;if(!await Browser.InvokeAsync<bool>("confirm","Revoke this runner capability and its issued child-run access? Account-authorized historical evidence remains."))return;if(Id!=target||Disposed)return;await Api.PostAsync<Acknowledgement>("projects/"+target+"/capabilities/"+capabilityId,new{});if(Id!=target||Disposed)return;if(NewCapability?.Id==capabilityId)ClearCapability();await ReadProject();Done("Runner key revoked.");});
void SelectBaseline(RunSummary run){Baseline=run;Done("Baseline selected. Add the options below to your own runner command.");}
Task CreateInvite()=>Act(async()=>{var target=Id;var result=await Api.PostAsync<CreatedInvitation>("projects/"+target+"/invites",new{role=InvitationRole});if(Id!=target||Disposed)return;InvitationUrl=Origin+"account#invite="+Uri.EscapeDataString(result.Token);Done("Invitation ready. Share it with your teammate.");});
Task ChangeMember(string memberId,string role)=>Act(async()=>{var target=Id;if(!await Browser.InvokeAsync<bool>("confirm",$"Change this member's access to '{role}'? Downgrading or removing an editor revokes their issued runner capabilities."))return;if(Id!=target||Disposed)return;await Api.PostAsync<Acknowledgement>("projects/"+target+"/members/"+memberId,new{role});if(Id!=target||Disposed)return;await ReadProject();Done("Access updated.");});
}

