@page "/runs/{Id}"
@inherits ActionPage
@inject PortalApi Api
@inject NavigationManager Navigation
<PageTitle>Run result — Retry Assurance</PageTitle><StatusMessage Text="@Message" Error="@Failed" />
@if(Evidence is null){<h1>@(Reading?"Loading result":"Result unavailable")</h1>@if(!Reading){<a href="@("account?next="+Uri.EscapeDataString("/runs/"+Id))">Sign in with project access</a>}}
else
{
var run=Evidence.Run;
<div class="title-row"><h1>Retry check result</h1><span class="verdict large @(run.Result?.Verdict??"open")">@(run.Result?.Verdict??run.State)</span></div><div class="actions"><a class="button" href="@("projects/"+run.ProjectId)">Project</a><button disabled="@Busy" @onclick="Refresh">Refresh</button><button disabled="@Busy" @onclick="Export">Download evidence</button></div><p class="quiet">Includes client notes and labels. Check them before sharing.</p>
<section class="effect-count"><div><strong>@Evidence.Resources.Count</strong><span>test jobs created</span></div><div><strong>@Evidence.Requests.Count</strong><span>requests recorded</span></div><div><strong>@Evidence.Requests.Select(item=>item.KeyHash).Distinct().Count()</strong><span>keys used</span></div></section>
@if(run.Result is {} result){<section class="result-panel"><h2>Check result</h2>@if(result.Issues.Count==0){<p>One job was created and the final client outcome was allowed.</p>}else{<ul>@foreach(var issue in result.Issues){<li>@issue</li>}</ul>}<div class="report-boundary"><h3>Client outcome: @ClientOutcome(result.RunnerReported.Terminal)</h3>@if(result.RunnerReported.Terminal=="success"){<p>@(result.RunnerReported.ReturnedResourceObserved?"Its returned job ID matches a created job.":"Its returned job ID does not match a created job.")</p>}@if(run.RunnerObservation?.Detail is {Length:>0} note){<p class="client-note">@note</p>}<details><summary>Reported client details</summary><p>Client and build labels are supplied by the runner. They do not verify the source code used.</p>@if(result.RunnerReported.ReturnedResourceId is not null){<p class="mono">Returned job ID: @result.RunnerReported.ReturnedResourceId</p>}</details></div></section>}
else{<section class="notice"><strong>No final result yet.</strong><p>Refresh if the client is still running. If it stopped, start a new run.</p><p class="quiet">Run access expires @Time(run.ExpiresAt). Recorded requests remain available.</p></section>}
<section class="panel"><h2>What each request did</h2><ol class="journal">@foreach(var request in Evidence.Requests){<li><div class="journal-number">@request.Sequence</div><div><h3>@RequestOutcome(request)</h3><p>@KeyLabel(request.KeyHash) · @PayloadLabel(request.PayloadHash) · @ResponseLabel(request.ResponsePolicy)</p><details><summary>Request details</summary><p>@request.Method @request.PathLabel · prepared HTTP @request.ResponseStatus</p><p class="quiet">A prepared response does not prove the client received it.</p><dl><dt>Attempt ID</dt><dd class="mono">@request.AttemptId</dd><dt>Key fingerprint</dt><dd class="mono digest">@request.KeyHash</dd><dt>Request-data fingerprint</dt><dd class="mono digest">@request.PayloadHash</dd><dt>Body size</dt><dd>@request.BodyBytes bytes; body not retained</dd><dt>Recorded at</dt><dd>@Time(request.ReceivedAt)</dd><dt>Job ID</dt><dd class="mono">@(request.ResourceId??"None")</dd></dl></details></div></li>}</ol>@if(Evidence.Requests.Count==0){<p>No requests recorded.</p>}</section>
<details class="panel"><summary>Created job IDs</summary><ul class="record-list">@foreach(var resource in Evidence.Resources){<li><div><strong class="mono">@resource.Id</strong><p class="mono quiet">Created by request @resource.CreatedByRequest</p><p>Recorded @Time(resource.CommittedAt)</p></div></li>}</ul>@if(Evidence.Resources.Count==0){<p>No jobs created.</p>}</details>
<details class="panel"><summary>Run settings and identifiers</summary><dl class="identity"><dt>Run ID</dt><dd class="mono">@run.Id</dd><dt>Operation ID</dt><dd class="mono">@run.LogicalOperationId</dd><dt>Client</dt><dd>@run.Client</dd><dt>Package</dt><dd>@run.PackageVersion</dd><dt>Build label</dt><dd class="mono">@run.CommitId</dd><dt>Check version and fingerprint</dt><dd>@run.ContractRevision <code class="digest">@run.ContractHash</code></dd><dt>Scenario version and fingerprint</dt><dd>@run.PackVersion <code class="digest">@run.PackHash</code></dd><dt>Allowed client outcomes</dt><dd>@string.Join(", ",run.Contract.AllowedTerminals.Select(ClientOutcome))</dd></dl><p class="quiet">Times describe journal records, not exact cross-computer timing.</p></details>
<section class="panel"><h2>Compare with another run</h2><label>Baseline run ID from this project<input @bind="BaselineId" maxlength="36" disabled="@Busy"></label><button disabled="@(Busy||BaselineId.Length==0)" @onclick="Compare">Compare</button>@if(run.ReplayOf is not null){<p>Baseline: <a href="@("runs/"+run.ReplayOf)">@run.ReplayOf</a>.</p>}<details><summary>Compare the next run</summary><p>Add these options to your own runner command. They do not run a replacement example client.</p><pre>@ReplayCommand</pre><button disabled="@Busy" @onclick="()=>Act(()=>Copy(ReplayCommand))">Copy comparison options</button></details></section>
}
@code{
[Parameter]public string Id{get;set;}="";ExecutionEvidence? Evidence;string BaselineId="";bool Reading=true;
string ReplayCommand=>Evidence is null?"":$"--server {new Uri(Navigation.BaseUri).AbsoluteUri} --commit YOUR_NEW_COMMIT --baseline {Evidence.Run.Id} --revision {Evidence.Run.ContractRevision}";
protected override async Task OnParametersSetAsync(){var target=Id;Reading=true;Evidence=null;Message="";try{var result=await Api.GetAsync<ExecutionEvidence>("runs/"+target);if(!Disposed&&Id==target){Evidence=result;BaselineId=result.Run.ReplayOf??"";}}catch(Exception error){if(!Disposed&&Id==target)ShowFailure(error);}finally{if(!Disposed&&Id==target)Reading=false;}}
Task Refresh()=>Act(async()=>{var target=Id;var result=await Api.GetAsync<ExecutionEvidence>("runs/"+target);if(Disposed||Id!=target)return;Evidence=result;Done("");});
Task Export()=>Act(async()=>{if(Evidence is null)return;var captured=Evidence;await Download("retry-assurance-evidence-"+captured.Run.Id+".json",System.Text.Json.JsonSerializer.Serialize(captured,new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web){WriteIndented=true}),"application/json");if(Id==captured.Run.Id)Done("Evidence downloaded. Evidence downloaded.");});
void Compare(){if(Guid.TryParse(BaselineId,out _)&&Evidence is not null)Navigation.NavigateTo("compare/"+Evidence.Run.Id+"/"+BaselineId);else{Message="Enter a valid earlier run ID from this project.";Failed=true;}}    string KeyLabel(string hash)=>"Key "+(Evidence!.Requests.Select(item=>item.KeyHash).Distinct().ToList().IndexOf(hash)+1);
    string PayloadLabel(string hash)=>"Data "+(Evidence!.Requests.Select(item=>item.PayloadHash).Distinct().ToList().IndexOf(hash)+1);
    static string RequestOutcome(RequestEvidence request)=>request.ResponsePolicy=="payload-conflict"?"Rejected: key reused with different data":request.Effect=="created"?"Created a job":request.Effect=="reused"?"Reused the existing job":"No job effect";
    static string ResponseLabel(string policy)=>policy switch{"commit-then-delay"=>"reply delayed three seconds","immediate-replay"=>"immediate reply","payload-conflict"=>"data conflict",_=>policy};
}
