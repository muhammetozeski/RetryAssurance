@page "/runs/{Id}"
@inherits ActionPage
@inject PortalApi Api
@inject NavigationManager Navigation
<PageTitle>Execution evidence — Retry Assurance</PageTitle><StatusMessage Text="@Message" Error="@Failed" />
@if(Evidence is null){<h1>Read actual execution evidence</h1><p>An authorized account session is required. An execution ID is not a capability.</p><a href="/account">Open account access</a>}
else
{
var run=Evidence.Run;
<div class="title-row"><div><span class="eyebrow">SERVER-OWNED JOURNAL · ONE LOGICAL OPERATION</span><h1>Execution evidence</h1></div><span class="verdict large @(run.Result?.Verdict??"open")">@(run.Result?.Verdict??run.State)</span></div><p class="mono">@run.Id</p><div class="actions"><a class="button" href="@("/projects/"+run.ProjectId)">Return to actual project</a><button disabled="@Busy" @onclick="Refresh">Read current server evidence</button><button disabled="@Busy" @onclick="Export">Download allowlisted evidence JSON</button></div>
<section class="effect-count"><div><strong>@Evidence.Resources.Count</strong><span>durable remote resource(s)</span></div><div><strong>@Evidence.Requests.Count</strong><span>accepted HTTP attempt(s)</span></div><div><strong>@Evidence.Requests.Select(item=>item.KeyHash).Distinct().Count()</strong><span>distinct operation-key digest(s)</span></div></section>
@if(run.Result is {} result){<section class="result-panel"><h2>What the server concluded</h2>@if(result.Issues.Count==0){<p>The exercised scenario met the pinned single-resource invariant and declared terminal policy.</p>}else{<ul>@foreach(var issue in result.Issues){<li>@issue</li>}</ul>}<p>@result.Coverage</p><div class="report-boundary"><h3>Separately runner-reported</h3><p>Terminal observation: <strong>@result.RunnerReported.Terminal</strong></p><p>Returned resource matched this server journal: <strong>@result.RunnerReported.ReturnedResourceObserved</strong></p>@if(result.RunnerReported.ReturnedResourceId is not null){<p class="mono">@result.RunnerReported.ReturnedResourceId</p>}<p class="quiet">The server checks that reference against its own resources. The service does not independently attest arbitrary client source code or the runner's terminal claim.</p></div></section>}
else{<section class="notice"><strong>This execution has no finalized server verdict.</strong><p>Open, expired or interrupted execution state is not presented as a passing result. Finish through the original authorized runner. New executions keep their own effect sets.</p></section>}
<section class="panel"><h2>Accepted request sequence</h2><p class="quiet">Sequence is assigned by the server's atomic admission. Journal timestamps are server-recorded request/effect times, not exact database-commit completion measurements or cross-computer ordering proof.</p><ol class="journal">@foreach(var request in Evidence.Requests){<li><div class="journal-number">@request.Sequence</div><div><h3>@request.Method @request.PathLabel · HTTP @request.ResponseStatus</h3><p><span class="tag">@request.Effect</span> @request.ResponsePolicy</p><p class="mono quiet">Attempt @request.AttemptId</p><dl><dt>Operation key digest</dt><dd class="mono digest">@request.KeyHash</dd><dt>Canonical JSON payload digest</dt><dd class="mono digest">@request.PayloadHash</dd><dt>Request body size</dt><dd>@request.BodyBytes bytes — raw body not retained</dd><dt>Server journal time</dt><dd>@Time(request.ReceivedAt)</dd><dt>Referenced resource</dt><dd class="mono">@(request.ResourceId??"None")</dd></dl></div></li>}</ol>@if(Evidence.Requests.Count==0){<p>No accepted scenario request was recorded.</p>}</section>
<section class="panel"><h2>Durable resource effects</h2><ul class="record-list">@foreach(var resource in Evidence.Resources){<li><div><strong class="mono">@resource.Id</strong><p class="mono quiet">Created by request @resource.CreatedByRequest</p><p>Server journal record: @Time(resource.CommittedAt)</p></div></li>}</ul>@if(Evidence.Resources.Count==0){<p>No resource was created in this run.</p>}</section>
<section class="panel"><h2>Pinned execution identity</h2><dl class="identity"><dt>Logical operation</dt><dd class="mono">@run.LogicalOperationId</dd><dt>Client/package label</dt><dd>@run.Client</dd><dt>Package version declaration</dt><dd>@run.PackageVersion</dd><dt>Commit/build declaration</dt><dd class="mono">@run.CommitId</dd><dt>Contract revision and hash</dt><dd>@run.ContractRevision <code class="digest">@run.ContractHash</code></dd><dt>Scenario-pack version and hash</dt><dd>@run.PackVersion <code class="digest">@run.PackHash</code></dd><dt>Allowed terminal observations</dt><dd>@string.Join(", ",run.Contract.AllowedTerminals)</dd></dl><p class="quiet">Package/build identity is declared by the invoking runner. A reproducible reference does not independently attest what arbitrary customer code executed.</p></section>
<section class="panel"><h2>Compare or repeat</h2><label>Earlier run ID in this same project<input @bind="BaselineId" maxlength="36" disabled="@Busy"></label><button disabled="@(Busy||BaselineId.Length==0)" @onclick="Compare">Compare the actual records</button>@if(run.ReplayOf is not null){<p>This is a new execution from baseline <a href="@("/runs/"+run.ReplayOf)">@run.ReplayOf</a>.</p>}<p>To repeat, keep a private project capability and create another run with these explicit pins:</p><pre>@ReplayCommand</pre><button disabled="@Busy" @onclick="()=>Act(()=>Copy(ReplayCommand))">Copy secret-free replay command</button></section>
}
@code{
[Parameter]public string Id{get;set;}="";ExecutionEvidence? Evidence;string BaselineId="";
string ReplayCommand=>Evidence is null?"":$"dotnet examples/CorrectClient/bin/Release/net10.0/CorrectClient.dll --server {new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)} --commit YOUR_NEW_ACTUAL_COMMIT --baseline {Evidence.Run.Id} --revision {Evidence.Run.ContractRevision}";
protected override async Task OnParametersSetAsync(){var target=Id;Evidence=null;Message="";try{var result=await Api.GetAsync<ExecutionEvidence>("runs/"+target);if(!Disposed&&Id==target){Evidence=result;BaselineId=result.Run.ReplayOf??"";}}catch(Exception error){if(!Disposed&&Id==target)ShowFailure(error);}}
Task Refresh()=>Act(async()=>{var target=Id;var result=await Api.GetAsync<ExecutionEvidence>("runs/"+target);if(Disposed||Id!=target)return;Evidence=result;Done("Actual accepted request and durable resource evidence refreshed.");});
Task Export()=>Act(async()=>{if(Evidence is null)return;var captured=Evidence;await Download("retry-assurance-evidence-"+captured.Run.Id+".json",System.Text.Json.JsonSerializer.Serialize(captured,new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web){WriteIndented=true}),"application/json");if(Id==captured.Run.Id)Done("Allowlisted server evidence downloaded. No capability or raw customer payload is included.");});
void Compare(){if(Guid.TryParse(BaselineId,out _)&&Evidence is not null)Navigation.NavigateTo("/compare/"+Evidence.Run.Id+"/"+BaselineId);else{Message="Enter a valid earlier run ID from this project.";Failed=true;}}
}
