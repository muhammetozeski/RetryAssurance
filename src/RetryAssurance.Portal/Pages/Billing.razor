@page "/account/billing"
@inherits ActionPage
@inject PortalApi Api
@inject AccountSession Session
@inject NavigationManager Navigation
<PageTitle>Subscription — Retry Assurance</PageTitle><h1>Subscription</h1><StatusMessage Text="@Message" Error="@Failed" />
@if(State is {} state)
{
<p>Your allowance: @state.Plan.ProjectLimit owned projects and @state.Plan.MonthlyRunLimit checks per UTC calendar month.</p>
<div class="plan-grid"><section class="panel"><h2>Free</h2><p class="price">$0</p><ul><li>Two owned projects</li><li>Fifty checks per month</li><li>Run, inspect, export and compare results</li><li>Owner, editor and viewer access</li></ul><a class="button primary" href="projects/new">Set up a check</a></section><section class="panel"><h2>@state.Plan.Name</h2>
@if(state.Premium){<p class="notice">Team access is active.</p>}
@if(state.Configured){<p class="price">$@((state.Plan.AmountCents/100m).ToString("0.00"))<small> / month</small></p><ul><li>Twenty owned projects</li><li>One thousand checks per month</li></ul>}
@if(!state.Configured){<p class="notice">Subscriptions are unavailable. Free checks remain available.</p>}
else if(Session.Account is null){<a class="button" href="account?next=%2Faccount%2Fbilling">Sign in</a>}
else if(state.Premium){<button disabled="@Busy" @onclick="OpenManagement">Manage or cancel</button>}
else{ @if(state.Mode=="test"){<p>Test checkout does not activate Team access.</p>}<button class="primary" disabled="@Busy" @onclick="StartCheckout">@(state.Mode=="test"?"Open test checkout":"Continue to checkout")</button>}
</section></div>
@if(state.Subscriptions.Count>0){<details class="panel"><summary>Subscription history</summary><ul class="record-list">@foreach(var item in state.Subscriptions){<li><div><strong>@item.Status @(item.IsLive==1?"":"· test record")</strong>@if(item.ExpiresAt>0){<p>Period ends @Time(item.ExpiresAt)</p>}<p class="mono">@item.Id</p></div></li>}</ul>@if(state.Configured&&Session.Account is not null){<button disabled="@Busy" @onclick="OpenManagement">Manage subscription</button>}</details>}
<details><summary>After checkout</summary><p>Refresh this page to check access. Cancelling renewal keeps access through the paid period. Manage payment and cancellation with the provider.</p></details>
}
else if(Busy){<p>Loading subscription.</p>}
<button disabled="@Busy" @onclick="Load">Refresh status</button>
@code{
BillingState? State;string CheckoutRequestId=Guid.NewGuid().ToString();
protected override Task OnInitializedAsync()=>Load();
Task Load()=>Act(async()=>{if(!Session.Loaded)await Session.RefreshAsync();var value=await Api.GetAsync<BillingState>("billing");if(!Disposed)State=value;});
Task StartCheckout()=>Act(async()=>{var destination=await Api.PostAsync<BillingDestination>("billing/checkout",new{requestId=CheckoutRequestId});if(!Uri.TryCreate(destination.Url,UriKind.Absolute,out var target)||target.Scheme!="https"||target.Host!="checkout.stripe.com")throw new InvalidOperationException("The provider returned an unexpected destination.");Navigation.NavigateTo(destination.Url,true);});
Task OpenManagement()=>Act(async()=>{var destination=await Api.PostAsync<BillingDestination>("billing/portal",new{});if(!Uri.TryCreate(destination.Url,UriKind.Absolute,out var target)||target.Scheme!="https"||target.Host!="billing.stripe.com")throw new InvalidOperationException("The provider returned an unexpected management destination.");Navigation.NavigateTo(destination.Url,true);});
}
