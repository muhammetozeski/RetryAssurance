@inherits LayoutComponentBase
@implements IDisposable
@inject AccountSession Session
<div class="service-layout"><header class="topbar"><a class="brand" href="" aria-label="Retry Assurance home"><span class="brand-mark">R↻</span><span>RETRY<br>ASSURANCE</span></a><div class="topline"><span class="session-label">@if(Session.Loaded){@if(Session.Account is {} account){@account.Alias}else{<a href="account">Sign in</a>}}</span></div><div data-ra-theme-control></div></header><div class="body-grid"><aside class="navigation"><nav aria-label="Main navigation"><NavLink href="projects">Projects</NavLink><NavLink href="packs">Test scenario</NavLink><NavLink href="runner">Run your client</NavLink><NavLink href="account">Account</NavLink><NavLink href="account/billing">Subscription</NavLink><NavLink href="privacy">Privacy</NavLink></nav></aside><main id="main-content" class="stage">@if(SessionError.Length>0){<div class="notice error">@SessionError</div>}@Body</main></div><footer class="site-footer"><a href="privacy">Privacy</a><a href="https://github.com/muhammetozeski/RetryAssurance" target="_blank" rel="noopener">Source</a></footer></div>
@code{
string SessionError="";
protected override async Task OnInitializedAsync(){Session.Changed+=Changed;try{if(!Session.Loaded)await Session.RefreshAsync();}catch{SessionError="Could not check sign-in. Open Account to try again.";}}
void Changed(){if(Session.Loaded)SessionError="";_ = InvokeAsync(StateHasChanged);}
public void Dispose()=>Session.Changed-=Changed;
}
