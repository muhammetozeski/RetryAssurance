@inherits LayoutComponentBase
@implements IDisposable
@inject AccountSession Session
<div class="service-layout"><header class="topbar"><a class="brand" href="/" aria-label="Retry Assurance home"><span class="brand-mark">R↻</span><span>RETRY<br>ASSURANCE</span></a><div class="topline"><span class="system-label">REAL CLIENT · SYNTHETIC REMOTE EFFECTS</span><span class="session-label">@(Session.Loaded?Session.Account?.Alias??"Local source, real service":"Reading session")</span></div><div data-ra-theme-control></div></header><div class="body-grid"><aside class="navigation"><nav aria-label="Service"><NavLink href="/projects">Projects</NavLink><NavLink href="/packs">Maintained pack</NavLink><NavLink href="/runner">Run your client</NavLink><NavLink href="/account">Account &amp; access</NavLink><NavLink href="/account/billing">Subscription</NavLink><NavLink href="/privacy">Data boundary</NavLink></nav><div class="rail-explanation"><strong>One operation.</strong><p>Repeated HTTP attempts belong to the same logical job. Durable effects decide the invariant.</p><a href="https://github.com/muhammetozeski/RetryAssurance" target="_blank" rel="noopener">Public source ↗</a></div></aside><main id="main-content" class="stage">@if(SessionError.Length>0){<div class="notice error">@SessionError</div>}@Body</main></div><footer class="site-footer"><span>Customer code executes in your environment. No production proxy. No advertising trackers.</span><a href="/privacy">Data and ownership</a></footer></div>
@code{
string SessionError="";
protected override async Task OnInitializedAsync(){Session.Changed+=Changed;try{if(!Session.Loaded)await Session.RefreshAsync();}catch{SessionError="The session service could not be read. Your account state has not been assumed; refresh when connectivity returns.";}}
void Changed()=>InvokeAsync(StateHasChanged);
public void Dispose()=>Session.Changed-=Changed;
}
